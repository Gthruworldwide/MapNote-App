<?xml version="1.0" encoding="utf-8"?>
<!-- Launch splash: the transparent RouteNote lockup (tool/gen_brand_logo.ps1)
     centred on the theme background, so it follows the light/dark LaunchTheme
     (white in values/, black in values-night/) without a night drawable. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="?android:colorBackground" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
