# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Gradle build output
/android/build/
/android/.gradle/
/android/local.properties

# Android signing secrets — never commit these.
# `android/.gitignore` already covers the android/ tree; these root-level
# patterns are the explicit backstop in case a keystore is ever created
# outside `android/`. See tool/create_upload_keystore.ps1.
key.properties
*.jks
*.keystore

# Dev-machine supervisor agent (tool/) — never commit keys or reports
/tool/.env
/tool/reports/

# Local audit scratch space (pulled Hive boxes, device logs, build logs)
/.scratch/
